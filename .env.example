# Copy to .env and fill in.  .env is gitignored.

# API key:  gumloop.com/settings/profile/connectors?view=connected
#            (the Connectors page, not Profile. Requires Pro or above.)
# User id:   gumloop.com/settings/profile/general, under your email.
GUMLOOP_API_KEY=
GUMLOOP_USER_ID=

# The agent under test — the last path segment of the agent's URL,
# gumloop.com/agents/<gummie_id>. One per prompt version; set it per run:
#   GUMLOOP_GUMMIE_ID=<v1 id> RUN_NAME=v1-grounded npm run experiment
GUMLOOP_GUMMIE_ID=

# Repeats per question. The regression is a shift in how often the agent
# samples instead of aggregating, not a hard failure, so a single trial per
# question buries it in noise.
TRIAL_COUNT=3

# Gumloop caps concurrent agent interactions per plan. 3 is safe on Pro.
MAX_CONCURRENCY=3

# EVAL_LIMIT=4    # smoke run, spread across question types
